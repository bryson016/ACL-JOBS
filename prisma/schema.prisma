// ACL Jobs / Advenware Career Link — Prisma schema.
//
// Works with BOTH SQLite (default, for local dev / "just works" mode)
// and MySQL (for production deployment against the original database).
//
// To switch providers, change the `provider` line below AND the
// DATABASE_URL in backend/.env:
//   - SQLite: provider = "sqlite", DATABASE_URL="file:./acl_jobs.db"
//   - MySQL : provider = "mysql",  DATABASE_URL="mysql://user:pass@host:3306/db"
//
// Enums are represented as `String` with documented value sets so
// the schema is valid for both providers. Application code passes
// and compares the same string values ("job_seeker", "active", etc.).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Users
//   role values: "job_seeker" | "employer" | "admin"
// ============================================================
model users {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  email      String    @unique
  password   String
  role       String    @default("job_seeker")
  is_active  Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  company       companies?
  profile       profiles?
  auth_tokens   auth_tokens[]
  applications  applications[]
  notifications notifications[]
  interviews    interviews[]

  @@index([role])
  @@index([is_active])
}

// ============================================================
// Companies
// ============================================================
model companies {
  id          Int      @id @default(autoincrement())
  user_id     Int      @unique
  name        String
  slug        String   @unique
  description String?
  website     String?
  email       String?
  phone       String?
  address     String?
  logo        String?
  industry    String?
  size        String?
  is_active   Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  user       users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jobs       jobs[]
  interviews interviews[]

  @@index([name])
}

// ============================================================
// Profiles
// ============================================================
model profiles {
  id                 Int      @id @default(autoincrement())
  user_id            Int      @unique
  full_name          String
  username           String?
  email              String?
  phone              String?
  location           String?
  bio                String?
  skills             String?
  education          String?
  experience         String?
  professional_title String?
  years_of_experience String?
  employment_type    String?
  work_preference    String?
  expected_salary    String?
  career_objective   String?
  profile_photo      String?
  cv_url             String?
  profile_completion Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([full_name])
}

// ============================================================
// Jobs
//   status values: "active" | "closed" | "draft" | "archived"
// ============================================================
model jobs {
  id              Int      @id @default(autoincrement())
  company_id      Int
  title           String
  description     String
  location        String
  category        String?
  employment_type String
  salary          String?
  requirements    String?
  status          String   @default("active")
  is_featured     Int      @default(0)
  views_count     Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  company      companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  applications applications[]
  saved_jobs   saved_jobs[]
  interviews   interviews[]

  @@index([company_id])
  @@index([status])
  @@index([is_featured])
  @@index([category])
  @@index([location])
  @@index([employment_type])
}

// ============================================================
// Applications
//   status values:
//     "pending" | "reviewing" | "shortlisted" | "interview"
//     "accepted" | "rejected" | "withdrawn"
// ============================================================
model applications {
  id           Int      @id @default(autoincrement())
  user_id      Int
  job_id       Int
  status       String   @default("pending")
  cover_letter String?
  cv_url       String?
  applied_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  job         jobs          @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  interviews  interviews[]

  @@unique([user_id, job_id])
  @@index([user_id])
  @@index([job_id])
  @@index([status])
  @@index([applied_at])
}

// ============================================================
// Saved jobs
// ============================================================
model saved_jobs {
  id       Int      @id @default(autoincrement())
  user_id  Int
  job_id   Int
  saved_at DateTime @default(now())

  job jobs @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_id, job_id])
  @@index([user_id])
  @@index([job_id])
}

// ============================================================
// Interviews
//   status values: "scheduled" | "completed" | "cancelled" | "rescheduled"
// ============================================================
model interviews {
  id             Int      @id @default(autoincrement())
  application_id Int
  job_id         Int
  user_id        Int
  company_id     Int
  title          String
  description    String?
  scheduled_at   DateTime
  duration       Int      @default(60)
  location       String?
  meeting_link   String?
  status         String   @default("scheduled")
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  application applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  job         jobs         @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  company     companies    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([application_id])
  @@index([job_id])
  @@index([user_id])
  @@index([company_id])
  @@index([scheduled_at])
  @@index([status])
}

// ============================================================
// Notifications
// ============================================================
model notifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String
  title      String
  message    String
  data       String?
  is_read    Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([type])
  @@index([created_at])
}

// ============================================================
// Auth tokens
// ============================================================
model auth_tokens {
  id           Int      @id @default(autoincrement())
  user_id      Int
  token        String
  token_hash   String   @unique
  expires_at   DateTime
  created_at   DateTime @default(now())
  last_used_at DateTime?
  is_revoked   Int      @default(0)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_revoked])
}
