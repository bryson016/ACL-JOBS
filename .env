# ACL Jobs API — environment configuration
#
# The only database setting you need is DATABASE_URL.
# Prisma reads it directly from the env.
#
# Default (works out of the box, no DB server required):
#   file:./acl_jobs.db   (SQLite, perfect for local dev)
#
# To switch to MySQL (e.g. for production or to talk to the
# original PHP database), change BOTH:
#   1) prisma/schema.prisma  →  provider = "mysql"
#   2) DATABASE_URL          →  mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
DATABASE_URL=file:./acl_jobs.db

# JWT secret used to sign authentication tokens.
# CHANGE THIS in production — keep it long and random.
JWT_SECRET=acl_jobs_secret_key_change_in_production_2024

# Optional:
# PORT — assigned automatically by Render; default 5000 for local dev.
