# ACL Jobs API — environment configuration
#
# The only database setting you need is DATABASE_URL.
# Prisma reads it directly from the env (provider = "postgresql" in
# prisma/schema.prisma).
#
# Production: the Render PostgreSQL database "acl_jobs". sslmode=require
# is required when connecting to Render Postgres from outside their
# network.
#
# Local dev alternative (no DB server needed):
#   1) prisma/schema.prisma  →  provider = "sqlite"
#   2) DATABASE_URL          →  file:./acl_jobs.db
#
DATABASE_URL=postgresql://acl_jobs_user:FzcdtNinnET5W2qAEMNvZtDs6xzx6yVO@dpg-daf7qjeq1p3s73c2ujn0-a.oregon-postgres.render.com/acl_jobs?sslmode=require

# JWT secret used to sign authentication tokens.
# CHANGE THIS in production — keep it long and random.
JWT_SECRET=acl_jobs_secret_key_change_in_production_2024

# Optional:
# PORT — assigned automatically by Render; default 5000 for local dev.
